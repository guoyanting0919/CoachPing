// 健身教練排課推播系統 — 資料模型
// 規格見 SPEC.md §4。修改前請先更新 SPEC.md。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CoachMemberStatus {
  active
  inactive
}

enum SessionStatus {
  scheduled
  cancelled
  completed
}

/// 一堂課由誰發起。落地欄位，不靠 createdAt 反推——教練點開課表看到一堂自己
/// 沒印象排的課時，這是唯一能回答他的地方。見 SPEC.md §3.6、ADR-0002。
enum SessionOrigin {
  coach_scheduled
  member_booked
}

enum LeaveStatus {
  auto_approved
  pending
  approved
  rejected
}

enum NotificationStatus {
  pending
  /// 已被某次 cron 取走、正在送出。用於避免兩次 cron 重疊時重複推播。
  sending
  sent
  failed
  /// 取走後發現內容已失效（例如課程在排入佇列後被取消），沒有真的送出。
  /// 與 sent 分開才算得準計費推播數——LINE 只對真的送出去的訊息收費（SPEC.md §16）。
  skipped
}

/// 通知類型。對應 SPEC.md §5。
enum NotificationType {
  member_reminder // 學員：課前提醒
  member_change // 學員：課程取消／改期
  member_schedule // 學員：教練排課完成後的課表彙總
  coach_daily // 教練：每日 08:00 今日課表彙總（已取消，見 SPEC.md §5）
  coach_leave // 教練：學員請假通知
  coach_booking // 教練：學員預約了一堂課（SPEC.md §3.6）
}

model Coach {
  id         String @id @default(uuid())
  lineUserId String @unique @map("line_user_id")
  name       String

  /// 教練自己的 LINE 官方帳號連結。學員版 Rich Menu「聯絡教練」靠它跳轉，必填。
  oaUrl String @map("oa_url")

  /// 預留 B2B（健身房管理端），MVP 恆為 null。
  gymId String? @map("gym_id")

  /// 請假自動核准門檻（小時）。距上課 >= 此值即自動核准。
  leaveDeadlineHours Int @default(24) @map("leave_deadline_hours")

  /// 課前提醒提前時數。
  reminderHours Int @default(24) @map("reminder_hours")

  defaultDuration Int @default(60) @map("default_duration")

  /// 預約總開關（SPEC.md §3.6）。關閉、或開啟但 availability 為 0 筆，學員一律無法預約。
  /// 刻意容許這兩個真相來源並存，代價由設定頁的警示文字補償。
  bookingEnabled Boolean @default(false) @map("booking_enabled")

  /// 最短提前預約時間（小時）。早於 now + 此值的時段不出現在學員的可選清單。
  bookingLeadHours Int @default(24) @map("booking_lead_hours")

  /// 同一學員同時未上課的預約上限。系統不做堂數包／扣抵（SPEC.md §11），
  /// 這是唯一阻止學員把教練整週約滿的機制。動它之前請先讀 ADR-0002。
  maxOpenBookings Int @default(3) @map("max_open_bookings")

  /// iCal 訂閱網址的秘密 token（SPEC.md §9）。
  icalToken String @unique @default(uuid()) @map("ical_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members       CoachMember[]
  invites       Invite[]
  sessions      Session[]
  notifications Notification[]
  availability  CoachAvailability[]
  blocks        CoachBlock[]

  @@map("coaches")
}

model Member {
  id String @id @default(uuid())

  /// 學員自報的名字，僅用於學員端自己的畫面。教練端請讀 coach_members.display_name。
  displayName String @map("display_name")

  /// null 表示尚未完成註冊。教練仍可為其排課，推播時跳過並改走降級流程（SPEC.md §8）。
  lineUserId String? @unique @map("line_user_id")

  /// 推播失敗（學員封鎖本 OA）時標記。教練端須顯示警示。
  lineBlocked Boolean @default(false) @map("line_blocked")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coaches       CoachMember[]
  invites       Invite[]
  participation SessionParticipant[]
  leaveRequests LeaveRequest[]

  @@map("members")
}

/// 師生關係為多對多（SPEC.md §4）。同一學員可同時屬於多位教練。
/// 隱私硬規則：教練只能讀取自己的關係與 session，不得得知學員的其他教練。
model CoachMember {
  coachId  String            @map("coach_id")
  memberId String            @map("member_id")
  status   CoachMemberStatus @default(active)

  /// 這位教練對該學員的稱呼。教練端一律顯示此欄位，不讀 members.display_name——
  /// 同一學員可能屬於多位教練，共用名字會讓 A 教練取的稱呼洩漏給 B 教練。
  displayName String @map("display_name")

  createdAt DateTime @default(now()) @map("created_at")

  coach  Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([coachId, memberId])
  @@index([memberId])
  @@map("coach_members")
}

/// 教練邀請碼。MVP 階段由開發者手動產生後私下給教練（SPEC.md §3.1），
/// 不做教練自助註冊。與 Invite（學員邀請）語義不同，故分表。
model CoachInvite {
  token     String    @id @default(uuid())
  /// 自用標記，方便辨識這組碼發給了誰。
  label     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  /// 使用後回填，方便追溯。
  coachId   String?   @map("coach_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("coach_invites")
}

/// 教練的可預約時段，以週為單位（SPEC.md §3.6）。
///
/// 休息時間不是一種資料，而是兩段區間之間的空隙：
/// 「8:00–18:00 休息 12:00–13:00」= 兩筆 (8:00,12:00) 與 (13:00,18:00)。
/// 獨立存休息欄位的話，「一天兩段休息」「各天休息不同」立刻要加維度；區間模型裡這些免費。
model CoachAvailability {
  id      String @id @default(uuid())
  coachId String @map("coach_id")

  /// 0=週日 … 6=週六，與 JS getDay() 一致（也與 time.ts 的 weekdayZh 取法一致）。
  weekday Int

  /// 自當日 00:00 起算的分鐘數，台北時間。存分鐘而非 time 型別是為了讓
  /// 格子運算是純整數比較，不必為每個候選時段建 Date。
  startMin Int @map("start_min")
  /// 恆 > startMin。同一 weekday 的區間經正規化後互不重疊（見 lib/booking.ts）。
  endMin   Int @map("end_min")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, weekday])
  @@map("coach_availability")
}

/// 教練暫時收回的一段具體時間（SPEC.md §3.7）。只能收回，不能加開。
///
/// 封鎖不影響既有課程——已排定或已被預約的課不會因為新增封鎖而消失，
/// 封鎖只讓那段時間不再產生新的可預約格子。
model CoachBlock {
  id      String @id @default(uuid())
  coachId String @map("coach_id")

  startAt DateTime @map("start_at")
  /// 整天 = 當日 00:00 至次日 00:00（台北時間）。
  endAt   DateTime @map("end_at")

  /// 自用備註（出國、受傷…）。不對學員顯示——學員只該知道「不可約」，不該知道原因。
  reason String?

  createdAt DateTime @default(now()) @map("created_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, startAt])
  @@map("coach_blocks")
}

/// 一次性邀請連結，綁定特定學員記錄（SPEC.md §3.2）。
model Invite {
  token     String    @id @default(uuid())
  coachId   String    @map("coach_id")
  memberId  String    @map("member_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  coach  Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([memberId])
  @@map("invites")
}

/// 一堂具體的課。重複課程展開成實體（SPEC.md §3.4），以 seriesId 串聯。
model Session {
  id       String  @id @default(uuid())
  coachId  String  @map("coach_id")
  /// 同一組重複課程共用。單次課程為 null。
  seriesId String? @map("series_id")

  startAt     DateTime @map("start_at")
  durationMin Int      @map("duration_min")
  /// 選填自由文字，連鎖健身房教練可能跨門店。
  location    String?

  status SessionStatus @default(scheduled)

  /// 誰發起的。既有資料回填為 coach_scheduled——預約功能上線前不存在學員預約。
  origin SessionOrigin @default(coach_scheduled)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coach         Coach                @relation(fields: [coachId], references: [id], onDelete: Cascade)
  participants  SessionParticipant[]
  leaveRequests LeaveRequest[]
  notifications Notification[]

  @@index([coachId, startAt])
  @@index([seriesId])
  @@index([startAt])
  @@map("sessions")
}

/// 1:N，N <= 3（1 對 1、1 對 2、1 對 3）。不支援團體課。
model SessionParticipant {
  sessionId String @map("session_id")
  memberId  String @map("member_id")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([sessionId, memberId])
  @@index([memberId])
  @@map("session_participants")
}

/// 請假狀態機見 SPEC.md §6。補課不做：請假即取消。
model LeaveRequest {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  memberId  String      @map("member_id")
  reason    String?
  status    LeaveStatus

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([memberId])
  @@map("leave_requests")
}

/// 推播佇列。所有推播一律經此表，由 cron 每分鐘掃出送發，
/// 不在 request 內直接 push（為了重試、稽核、防重複）。見 SPEC.md §5。
model Notification {
  id               String           @id @default(uuid())
  targetLineUserId String           @map("target_line_user_id")
  type             NotificationType
  payload          Json

  sendAt DateTime  @map("send_at")
  sentAt DateTime? @map("sent_at")

  status NotificationStatus @default(pending)
  error  String?

  /// 取走的時間。用於回收因程序中斷而卡在 sending 的項目。
  claimedAt DateTime? @map("claimed_at")

  /// 失敗重試次數。連續失敗多次即放棄，避免無效項目每分鐘重試。
  attempts Int @default(0)

  /// 來源 session。課程改期時據此找出並更新 sendAt，取消時作廢。
  /// 課程只會被標記取消、不會刪除，SetNull 僅為防禦性設定。
  sessionId String?  @map("session_id")
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  /// 這則推播該記在哪位教練頭上（SPEC.md §16 計費統計）。
  /// 排入佇列時就寫死，不靠 sessionId 反推——sessionId 可能被 SetNull，
  /// 一旦斷掉就永遠歸不了帳。null 代表舊資料回填不到，統計時歸「未歸屬」。
  coachId String? @map("coach_id")
  coach   Coach?  @relation(fields: [coachId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, sendAt])
  @@index([sessionId])
  @@index([coachId, sentAt])
  @@map("notifications")
}
